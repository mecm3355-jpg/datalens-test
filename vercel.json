{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "group-project-frontend-feature-datalens-frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "blob_upload": {
      "root": "group-project-blob-upload-service",
      "entrypoint": "api/blob-upload.ts"
    },
    "queue_worker": {
      "root": "group-project-queue-worker-service",
      "entrypoint": "api/process-job.ts",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ],
      "functions": {
        "api/process-job.ts": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "datalens-jobs",
              "retryAfterSeconds": 5
            }
          ]
        }
      }
    },
    "backend": {
      "root": "group-project-backend-feature-datalens-backend",
      "entrypoint": "app.vercel:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/blob-upload",
      "destination": {
        "service": "blob_upload"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
