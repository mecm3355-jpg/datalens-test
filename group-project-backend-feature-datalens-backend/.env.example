MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=datalens
AUTH_REQUIRED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_SECONDS=28800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_PASSWORD_RESET_SECONDS=1800
# 로컬 데모에서만 true. 운영에서는 이메일 발송 연동 전까지 반드시 false
AUTH_EXPOSE_RESET_TOKEN=false
# 운영 메일 발송. 세 값을 모두 설정하면 비밀번호 재설정 메일을 전송한다.
RESEND_API_KEY=
PASSWORD_RESET_FROM="DataLens <no-reply@example.com>"
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
STORAGE_PROVIDER=local
STORAGE_ROOT=storage
JOB_DISPATCH_MODE=local
MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=500
